<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('./partials/head', { titulo: 'Completadas' }) %>
</head>
<body class="min-h-screen flex flex-col bg-mist font-sans text-ink">
  <%- include('./partials/navbar', { activo: 'completadas' }) %>

  <main class="flex-grow w-full max-w-5xl mx-auto p-4 sm:p-6 lg:p-8">
    <div class="mb-8">
      <h1 class="text-4xl font-extrabold tracking-tight">Completadas</h1>
      <p class="text-ink/60 mt-1">
        <%= tareas.length %> <%= tareas.length === 1 ? 'tarea terminada' : 'tareas terminadas' %>
      </p>
    </div>

    <div id="mensaje" class="hidden mb-4 rounded-md px-4 py-3 font-medium"></div>

    <% if (tareas.length === 0) { %>
      <div class="bg-sheet rounded-lg border border-dashed border-ink/25 p-10 text-center">
        <p class="text-xl font-semibold">Aún no has completado ninguna tarea</p>
        <p class="text-ink/60 mt-1 mb-5">Las tareas que marques como completadas aparecerán aquí.</p>
        <a href="/" class="inline-block bg-signal text-white px-4 py-2 rounded-md font-semibold hover:brightness-110 transition">
          Ver pendientes
        </a>
      </div>
    <% } else { %>
      <section class="grid grid-cols-1 md:grid-cols-2 gap-5" id="lista-tareas">
        <% tareas.forEach(tarea => { %>
          <%- include('./partials/tarjeta', { tarea }) %>
        <% }) %>
      </section>
    <% } %>
  </main>

  <%- include('./partials/footer') %>
  <script src="/js/tareas.js"></script>
</body>
</html>
