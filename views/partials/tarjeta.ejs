<%# Tarjeta de una tarea. Recibe: tarea %>
<%
  const fecha = new Date(tarea.fecha_creacion).toLocaleDateString('es-ES', {
    day: 'numeric', month: 'long', year: 'numeric'
  });
%>
<article class="bg-sheet rounded-lg border border-ink/10 p-5 flex flex-col gap-3 <%= tarea.completado ? 'opacity-90' : '' %>" data-tarea-id="<%= tarea._id %>">
  <div class="flex items-start justify-between gap-3">
    <h3 class="text-xl font-bold text-ink leading-snug <%= tarea.completado ? 'line-through decoration-done decoration-2' : '' %>">
      <%= tarea.titulo %>
    </h3>
    <% if (tarea.completado) { %>
      <span class="shrink-0 text-xs font-semibold text-done bg-done/10 px-2 py-1 rounded-full">Completada</span>
    <% } %>
  </div>

  <% if (tarea.descripcion) { %>
    <p class="text-ink/75 whitespace-pre-line"><%= tarea.descripcion %></p>
  <% } else { %>
    <p class="text-ink/40 italic">Sin descripción</p>
  <% } %>

  <p class="text-sm text-ink/55">Creada el <%= fecha %></p>

  <div class="flex flex-wrap gap-2 pt-3 mt-auto border-t border-ink/10">
    <% if (!tarea.completado) { %>
      <button type="button" data-accion="completar" data-id="<%= tarea._id %>"
        class="bg-done text-white px-3 py-1.5 rounded-md font-semibold hover:brightness-110 transition">
        Completar
      </button>
      <a href="/tareas/<%= tarea._id %>/editar"
        class="bg-signal text-white px-3 py-1.5 rounded-md font-semibold hover:brightness-110 transition">
        Editar
      </a>
    <% } %>
    <button type="button" data-accion="eliminar" data-id="<%= tarea._id %>"
      class="ml-auto text-danger px-3 py-1.5 rounded-md font-semibold hover:bg-danger/10 transition">
      Eliminar
    </button>
  </div>
</article>
